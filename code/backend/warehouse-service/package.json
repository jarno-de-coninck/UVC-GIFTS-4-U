{
  "name": "warehouse-service",
  "version": "1.0.0",
  "description": "Warehouse service - consumes order messages from RabbitMQ",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "type-check": "tsc --noEmit && tsc --noEmit -p tests",
    "test": "node --experimental-vm-modules --no-warnings=ExperimentalWarning node_modules/jest/bin/jest.js",
    "lint": "eslint ."
  },
  "license": "MIT",
  "dependencies": {
    "amqplib": "^0.10.4",
    "dotenv": "^16.3.1",
    "express": "^4.18.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/amqplib": "^0.10.5",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.14",
    "@types/node": "^24.19.0",
    "@types/supertest": "^6.0.3",
    "eslint": "^10.15.0",
    "jest": "^29.7.0",
    "supertest": "^7.3.2",
    "ts-jest": "^29.4.15",
    "tsx": "^4.23.0",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.74.0"
  }
}
